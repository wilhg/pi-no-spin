{
  "name": "pi-no-spin",
  "version": "1.0.2",
  "description": "pi extension that detects when the LLM spins (repeats the same string over and over), interrupts generation, and reminds it to stop",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "loop",
    "spinning",
    "repetition",
    "guardrail",
    "deepseek"
  ],
  "license": "MIT",
  "type": "module",
  "author": "wilhg",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wilhg/pi-no-spin.git"
  },
  "scripts": {
    "test": "node tests/pi-no-spin.test.mts"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
